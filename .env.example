# ============================================================
# KINOBOT — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- Telegram Bot -----
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# ----- Admin Telegram IDs (comma-separated) -----
ADMIN_IDS=123456789,987654321

# ----- PostgreSQL -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kinobot
POSTGRES_USER=kinobot_user
POSTGRES_PASSWORD=strong_password_here
DATABASE_URL=postgresql+asyncpg://kinobot_user:strong_password_here@postgres:5432/kinobot

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here
REDIS_URL=redis://:redis_password_here@redis:6379/0

# ----- Admin Panel -----
ADMIN_SECRET_KEY=your_super_secret_jwt_key_min_32_chars
ADMIN_PANEL_URL=http://localhost:3000
API_URL=http://localhost:8000

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- App Settings -----
DEBUG=False
LOG_LEVEL=INFO
ENVIRONMENT=production

# ----- Rate Limiting -----
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ----- Pagination -----
MOVIES_PER_PAGE=5
